<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--#region Language Metadata -->
    <s:String x:Key="language_display_name">简体中文（林凛世）</s:String>
    <!--#endregion -->

    <!--#region MainWindow -->
    <s:String x:Key="mw_folder_path">文件夹路径</s:String>
    <s:String x:Key="mw_folder_not_found">未找到文件夹</s:String>
    <s:String x:Key="mw_patch">增强</s:String>
    <s:String x:Key="mw_restore">恢复</s:String>
    <s:String x:Key="mw_source_code">源码+原作：k1tbyte</s:String>
    <s:String x:Key="mw_made_by">中文+编译：林凛世</s:String>
    <s:String x:Key="mw_star_hint">免费开源项目，请支持原作者</s:String>
    <s:String x:Key="mw_copy_logs">将日志复制到剪切板</s:String>
    <s:String x:Key="mw_export_logs">将日志导出到文件</s:String>
    <s:String x:Key="mw_update_badge">新版本已发布</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">设置</s:String>
    <s:String x:Key="settings_language">语言</s:String>
    <s:String x:Key="settings_check_updates">启动时检查更新</s:String>
    <s:String x:Key="settings_check_prereleases">也包括预发布测试版本</s:String>
    <s:String x:Key="settings_save">保存</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">更新可用</s:String>
    <s:String x:Key="up_warning">WandEnhancer无法自动更新，请自行利用源码编译可执行程序。</s:String>
    <s:String x:Key="up_current_version">当前：</s:String>
    <s:String x:Key="up_latest_version">最新：</s:String>
    <s:String x:Key="up_release_notes">发布说明</s:String>
    <s:String x:Key="up_show_more">显示完整更新日志</s:String>
    <s:String x:Key="up_show_less">显示发布说明</s:String>
    <s:String x:Key="up_loading_changelog">加载中。。。</s:String>
    <s:String x:Key="up_changelog_failed">无法加载完整的更新日志。</s:String>
    <s:String x:Key="up_release_notes_unavailable">没有检测到有新发表的发布说明</s:String>
    <s:String x:Key="up_open_release">打开发布页面</s:String>
    <!--#endregion -->

    <!--#region EnhanceVectorsPopup -->
    <s:String x:Key="pv_activate_pro">激活 WeMod Pro</s:String>
    <s:String x:Key="pv_devtools">按F12打开开发者工具</s:String>
    <s:String x:Key="pv_disable_updates">禁用更新</s:String>
    <s:String x:Key="pv_remote_web_panel_preview">启用远程访问（测试版）</s:String>
    <s:String x:Key="pv_custom_scripts">自定义脚本</s:String>
    <s:String x:Key="pv_add_js_scripts">添加 .js</s:String>
    <s:String x:Key="pv_custom_scripts_hint">选定的 .js 文件被打包到 Wand 中，并在渲染器中加载。</s:String>
    <s:String x:Key="pv_no_custom_scripts">未选择任何脚本</s:String>
    <s:String x:Key="pv_start">开始</s:String>
    <s:String x:Key="pv_auto_apply">更新后自动应用</s:String>
    <s:String x:Key="pv_popup_title">我们要增强什么？</s:String>
    <s:String x:Key="pv_patch_method">修补方法</s:String>
    <s:String x:Key="pv_strategy_static">静态（推荐）</s:String>
    <s:String x:Key="pv_strategy_supervised">监督式（运行时）</s:String>
    <s:String x:Key="pv_strategy_hint">静态编辑磁盘上的 Wand，这会破坏其数字签名。每次启动时都会在内存中运行受监督的补丁程序—这可能会触发杀毒软件，并且可能无法在所有环境中正常工作。</s:String>
    <!--#endregion -->

    <!--#region Runtime log -->
    <s:String x:Key="log_install_found">在 {0} ({1}) 中找到wemod目录</s:String>
    <s:String x:Key="log_already_patched">WeMod已经修补。如果要再次打补丁，请先恢复备份。</s:String>
    <s:String x:Key="log_ready">准备修补。</s:String>
    <s:String x:Key="log_install_not_found">未找到 WeMod 目录。</s:String>
    <s:String x:Key="log_no_directory">无法完成。请先指定目录。</s:String>
    <s:String x:Key="log_invalid_directory">选定的文件夹 {0} 不是有效的 WeMod 目录。</s:String>
    <s:String x:Key="log_restore_failed">备份恢复失败： {0}</s:String>
    <s:String x:Key="log_patch_failed">修补失败： {0}</s:String>
    <s:String x:Key="log_copied">日志已复制到剪贴板。</s:String>
    <s:String x:Key="log_copy_failed">日志复制失败： {0}</s:String>
    <s:String x:Key="log_exported">日志导出到 {0}。</s:String>
    <s:String x:Key="log_export_failed">日志导出失败： {0}</s:String>
    <s:String x:Key="log_open_link_failed">无法在浏览器中打开 {0} 。</s:String>
    <s:String x:Key="dialog_pick_install">选择 WeMod 目录</s:String>
    <!--#endregion -->

</ResourceDictionary>
